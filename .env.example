# Persistent local/container paths. Production uses /srv/stock-watch/shared/data.
DATA_DIR=./data
DATABASE_PATH=./data/stock-watch.db
BUILD_SHA=development
LOG_LEVEL=INFO

# Automatic scheduler is deliberately disabled for local and first deployment.
MONITOR_ENABLED=false
SCHEDULE_TIMEZONE=Asia/Shanghai
WORKER_POLL_SECONDS=2

# Public HTTPS hostname handled by Caddy.
APP_DOMAIN=stock-watch.example.com

# Direct POST /push authentication (not used by WeCom callbacks).
PUSH_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS

# WeCom self-built application.
WECOM_CORP_ID=CHANGE_ME_CORP_ID
WECOM_AGENT_ID=1000002
WECOM_SECRET=CHANGE_ME_APPLICATION_SECRET
WECOM_TOUSER=CHANGE_ME_ALERT_RECIPIENT_USERID

# WeCom callback authentication and administrator allow-list.
WECOM_CALLBACK_TOKEN=CHANGE_ME_CALLBACK_TOKEN
WECOM_ENCODING_AES_KEY=CHANGE_ME_43_CHARACTER_ENCODING_AES_KEY
WECOM_ADMIN_USERIDS=CHANGE_ME_ADMIN_USERID

# Remote model. Keep blank for offline fake-mode tests.
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
NEWS_TIMEOUT_SECONDS=12
MODEL_TIMEOUT_SECONDS=90
PUSH_TIMEOUT_SECONDS=12
